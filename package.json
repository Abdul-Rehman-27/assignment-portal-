{
  "name": "assignment-portal",
  "version": "1.0.0",
  "description": "Assignment submission portal with automated testing",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=results.xml \"tests/*.test.js\"",
    "receiver": "node receiver/receiver.js"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "nodemailer": "^10.2.1"
  }
}
